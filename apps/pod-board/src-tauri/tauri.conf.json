{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pod Board",
  "version": "0.1.0",
  "identifier": "io.pdbot.podboard",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Pod Board", "width": 1180, "height": 720, "minWidth": 420, "minHeight": 320 }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
